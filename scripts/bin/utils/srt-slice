#!/usr/bin/env python3
"""
srt-slice — SRT 解析 + 音频切片 CLI

从 SRT 字幕文件切片音频，输出统一格式的 WAV + manifest。

== 依赖 ==
  ffmpeg (brew install ffmpeg)

== 安装 ==
  chmod +x 本文件
  mv 本文件 ~/bin/utils/srt-slice

== 用法 ==

  1) 只解析 SRT（不切片）：
     srt-slice parse --srt audio.srt --output segments.json

  2) 只切片音频（已有 segments.json）：
     srt-slice slice --audio audio.wav --segments segments.json --outdir sliced/

  3) 全流程（解析 + 切片）：
     srt-slice all --srt audio.srt --audio audio.wav --outdir sliced/ --tag jp1
"""

import argparse
import json
import math
import os
import re
import subprocess
import sys
from pathlib import Path

VERSION = "1.0.0"

# ── SRT 常量 ──
SRT_TIME_RE = re.compile(
    r"(\d{2}):(\d{2}):(\d{2})[,.](\d{3})\s*-->\s*(\d{2}):(\d{2}):(\d{2})[,.](\d{3})"
)
HTML_TAG_RE = re.compile(r"<[^>]+>")
MIN_DURATION_MS = 3000
MAX_DURATION_MS = 10000
MERGE_GAP_MS = 500

# ── Slice 常量 ──
TARGET_SR = 32000
TARGET_CHANNELS = 1
TARGET_SAMPLE_FMT = "s16"
SAFE_TAG_RE = re.compile(r"[^a-zA-Z0-9_-]")


def sanitize_tag(tag: str) -> str:
    return SAFE_TAG_RE.sub("_", tag).strip("_") or "audio"


# ═══════════════════════════════════════════════════════════════════
# SRT 解析
# ═══════════════════════════════════════════════════════════════════

def parse_srt(filepath: str) -> list[dict]:
    segments = []
    with open(filepath, "r", encoding="utf-8") as f:
        content = f.read()
    blocks = content.strip().split("\n\n")
    for block in blocks:
        lines = block.strip().split("\n")
        if len(lines) < 3:
            continue
        try:
            _ = int(lines[0].strip())
            ts_line = lines[1].strip()
            text_lines = lines[2:]
        except (ValueError, IndexError):
            ts_line = lines[0].strip()
            text_lines = lines[1:]
        match = SRT_TIME_RE.match(ts_line)
        if not match:
            continue
        g = match.groups()
        start_ms = int(g[0]) * 3600000 + int(g[1]) * 60000 + int(g[2]) * 1000 + int(g[3])
        end_ms = int(g[4]) * 3600000 + int(g[5]) * 60000 + int(g[6]) * 1000 + int(g[7])
        text = " ".join(text_lines).strip()
        text = HTML_TAG_RE.sub("", text).strip()
        if not text:
            continue
        duration_ms = end_ms - start_ms
        if duration_ms <= 0:
            continue
        segments.append({
            "index": len(segments) + 1,
            "start_ms": start_ms, "end_ms": end_ms,
            "text": text, "duration_ms": duration_ms,
        })
    return segments


def merge_segments(segments: list[dict]) -> list[dict]:
    if not segments:
        return []
    merged = []
    buffer = None

    def flush_buffer():
        nonlocal buffer
        if buffer is None:
            return
        dur = buffer["end_ms"] - buffer["start_ms"]
        if dur > MAX_DURATION_MS:
            buffer = None
            return
        if dur >= MIN_DURATION_MS:
            buffer["duration_ms"] = dur
            buffer["index"] = len(merged) + 1
            merged.append(buffer)
        buffer = None

    for seg in segments:
        dur = seg["duration_ms"]
        if dur >= MAX_DURATION_MS:
            flush_buffer()
            continue
        if buffer is None:
            buffer = dict(seg)
            if MIN_DURATION_MS <= dur < MAX_DURATION_MS:
                flush_buffer()
            continue
        gap = seg["start_ms"] - buffer["end_ms"]
        if gap < MERGE_GAP_MS or (buffer["end_ms"] - buffer["start_ms"]) < MIN_DURATION_MS:
            buffer["end_ms"] = seg["end_ms"]
            buffer["text"] = buffer["text"] + " " + seg["text"]
            buffer["duration_ms"] = buffer["end_ms"] - buffer["start_ms"]
            if buffer["duration_ms"] > MAX_DURATION_MS:
                buffer = None
            elif buffer["duration_ms"] >= MIN_DURATION_MS:
                flush_buffer()
        else:
            flush_buffer()
            buffer = dict(seg)
            if MIN_DURATION_MS <= dur < MAX_DURATION_MS:
                flush_buffer()
    flush_buffer()
    return merged


# ═══════════════════════════════════════════════════════════════════
# 音频切片
# ═══════════════════════════════════════════════════════════════════

def compute_rms(wav_path: str) -> float | None:
    try:
        cmd = ["ffmpeg", "-i", wav_path, "-f", "f64le", "-ac", "1",
               "-ar", "16000", "-y", "-loglevel", "error", "pipe:1"]
        result = subprocess.run(cmd, capture_output=True, timeout=10)
        if result.returncode != 0 or len(result.stdout) == 0:
            return None
        import struct
        samples = struct.unpack(f"<{len(result.stdout)//8}d", result.stdout)
        return math.sqrt(sum(s * s for s in samples) / len(samples))
    except Exception:
        return None


def slice_one(audio_path: str, segment: dict, outdir: str,
              source_tag: str, index: int) -> dict | None:
    start_sec = segment["start_ms"] / 1000.0
    duration_sec = segment["duration_ms"] / 1000.0
    slice_name = f"{source_tag}_{index:06d}"
    output_path = os.path.join(outdir, f"{slice_name}.wav")

    if os.path.exists(output_path):
        print(f"  [skip] {output_path}")
    else:
        print(f"  [{index}] {slice_name} ({start_sec:.1f}s + {duration_sec:.1f}s)")
        cmd = [
            "ffmpeg", "-i", audio_path, "-ss", f"{start_sec:.3f}",
            "-t", f"{duration_sec:.3f}", "-ar", str(TARGET_SR),
            "-ac", str(TARGET_CHANNELS), "-sample_fmt", TARGET_SAMPLE_FMT,
            "-map_metadata", "-1", "-y", output_path,
        ]
        result = subprocess.run(cmd, capture_output=True, text=True)
        if result.returncode != 0:
            print(f"  [ERROR] ffmpeg failed: {slice_name}", file=sys.stderr)
            return None
        if not os.path.exists(output_path) or os.path.getsize(output_path) == 0:
            if os.path.exists(output_path):
                os.remove(output_path)
            return None

    return {
        "slice_name": slice_name,
        "source": os.path.basename(audio_path),
        "start_ms": segment["start_ms"],
        "end_ms": segment["end_ms"],
        "text": segment.get("text", ""),
        "duration_ms": segment["duration_ms"],
    }


def slice_all(audio_path: str, segments: list[dict], outdir: str,
              source_tag: str, start_index: int = 1) -> list[dict]:
    outdir = Path(outdir)
    outdir.mkdir(parents=True, exist_ok=True)
    manifest = []
    idx = start_index
    for seg in segments:
        entry = slice_one(str(audio_path), seg, str(outdir),
                          sanitize_tag(source_tag), idx)
        if entry is not None:
            manifest.append(entry)
            idx += 1
    return manifest


# ═══════════════════════════════════════════════════════════════════
# CLI
# ═══════════════════════════════════════════════════════════════════

def cmd_parse(args):
    srt_path = Path(args.srt)
    if not srt_path.exists():
        print(f"[ERROR] SRT not found: {args.srt}", file=sys.stderr)
        sys.exit(1)
    output_path = Path(args.output)
    output_path.parent.mkdir(parents=True, exist_ok=True)

    raw = parse_srt(str(srt_path))
    print(f"Raw segments: {len(raw)}")
    cleaned = merge_segments(raw)
    print(f"Cleaned segments: {len(cleaned)} (discarded: {len(raw) - len(cleaned)})")

    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(cleaned, f, ensure_ascii=False, indent=2)
    print(f"Saved: {output_path}")


def cmd_slice(args):
    audio_path = Path(args.audio)
    if not audio_path.exists():
        print(f"[ERROR] Audio not found: {args.audio}", file=sys.stderr)
        sys.exit(1)
    seg_path = Path(args.segments)
    if not seg_path.exists():
        print(f"[ERROR] Segments not found: {args.segments}", file=sys.stderr)
        sys.exit(1)
    with open(seg_path, "r", encoding="utf-8") as f:
        segments = json.load(f)
    print(f"Segments: {len(segments)}, audio: {audio_path.name}")

    manifest = slice_all(str(audio_path), segments, args.outdir,
                         args.tag, args.start_index)
    manifest_path = Path(args.manifest)
    manifest_path.parent.mkdir(parents=True, exist_ok=True)
    with open(manifest_path, "w", encoding="utf-8") as f:
        json.dump(manifest, f, ensure_ascii=False, indent=2)
    print(f"Sliced: {len(manifest)} files -> {args.outdir}")
    print(f"Manifest: {manifest_path}")


def cmd_all(args):
    cmd_parse(args)
    args.segments = args.output
    cmd_slice(args)


def main():
    parser = argparse.ArgumentParser(description="SRT parser + audio slicer")
    parser.add_argument("--version", action="version", version=f"srt-slice {VERSION}")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser("parse", help="Parse SRT to segments JSON")
    p.add_argument("--srt", required=True)
    p.add_argument("--output", "-o", required=True)

    s = sub.add_parser("slice", help="Slice audio from segments JSON")
    s.add_argument("--audio", required=True)
    s.add_argument("--segments", required=True)
    s.add_argument("--outdir", required=True)
    s.add_argument("--manifest", required=True)
    s.add_argument("--tag", default="audio")
    s.add_argument("--start-index", type=int, default=1)

    a = sub.add_parser("all", help="Parse + slice in one pass")
    a.add_argument("--srt", required=True)
    a.add_argument("--audio", required=True)
    a.add_argument("--outdir", required=True)
    a.add_argument("--output", "-o", default="/tmp/segments.json")
    a.add_argument("--manifest", default="/tmp/manifest.json")
    a.add_argument("--tag", default="audio")

    args = parser.parse_args()
    {"parse": cmd_parse, "slice": cmd_slice, "all": cmd_all}[args.command](args)


if __name__ == "__main__":
    main()
