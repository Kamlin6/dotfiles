# ===== 新路径 (mlx-whisper + Silero v6 VAD) =====

def _run_mlx_whisper_with_vad(args):
    import numpy as np
    import torch
    from silero_vad import get_speech_timestamps
    import mlx_whisper

    _QUALITY_GOOD_THRESHOLD = -0.25
    _QUALITY_WARN_THRESHOLD = -0.35

    # 1. 模型路径 (env 覆盖)
    model_path = args.model or os.getenv(
        "WHISPER_MLX_MODEL",
        os.path.expanduser("~/models/whisper-mlx"),
    )
    vad_path = os.getenv(
        "WHISPER_VAD_MODEL",
        os.path.expanduser("~/models/silero-v6/silero_vad.onnx"),
    )
    print(f"[transcribe] backend=mlx, model={model_path}")

    # 2. 模型完整性检查
    if not _is_hf_repo_id(model_path) and not os.path.isdir(model_path):
        print(f"[transcribe] ERROR: {model_path} not found", file=sys.stderr)
        print(f"[transcribe] Run: bash ~/bin/utils/scripts/download_whisper_mlx.sh", file=sys.stderr)
        raise SystemExit(2)
    if not _is_hf_repo_id(model_path):
        for f in ("config.json", "model.safetensors", "multilingual.tiktoken"):
            if not os.path.isfile(os.path.join(model_path, f)):
                print(f"[transcribe] ERROR: {model_path} incomplete (missing {f})", file=sys.stderr)
                print(f"[transcribe] Run: bash ~/bin/utils/scripts/download_whisper_mlx.sh", file=sys.stderr)
                raise SystemExit(2)
        # BK-016: mlx-whisper 0.4.3 期望 weights.safetensors, HF repo 用 model.safetensors
        # 自动建 symlink, 修复版本不兼容
        weights_link = os.path.join(model_path, "weights.safetensors")
        if not os.path.exists(weights_link):
            os.symlink("model.safetensors", weights_link)
            print(f"[transcribe] created symlink: weights.safetensors → model.safetensors")
    if not os.path.isfile(vad_path):
        print(f"[transcribe] ERROR: {vad_path} not found", file=sys.stderr)
        print(f"[transcribe] Run: bash ~/bin/utils/scripts/download_silero_v6.sh", file=sys.stderr)
        raise SystemExit(2)

    # 3. VAD 拆段
    print(f"[transcribe] loading Silero v6 VAD (ONNX, 2MB)...")
    vad_model = _VADWrapper(vad_path)
    audio_np = _read_audio_ffmpeg(args.audio_path, target_sr=16000)
    wav = torch.from_numpy(audio_np)  # 1D tensor, silero-vad 内部会处理
    timestamps = get_speech_timestamps(
        wav, vad_model, sampling_rate=16000, return_seconds=True,
        min_speech_duration_ms=250,
        min_silence_duration_ms=100,
        max_speech_duration_s=30,
        speech_pad_ms=0,
    )
    print(f"[transcribe] VAD found {len(timestamps)} speech segments")

    if not timestamps:
        print(f"[transcribe] WARNING: no speech detected, writing empty output")
        _write_output(args, [], {"language": "unknown", "language_probability": None})
        return

    # 4. 逐段转录 + VAD 偏移
    all_segments = []
    last_language = None
    total = len(timestamps)
    quality_counts = {"GOOD": 0, "WARN": 0, "LOW": 0}
    quality_total = 0
    for i, ts in enumerate(timestamps):
        print(
            f"[transcribe] transcribing segment {i+1}/{total} "
            f"({ts['start']:.1f}s - {ts['end']:.1f}s)..."
        )
        chunk_start_sample = int(ts["start"] * 16000)
        chunk_end_sample = int(ts["end"] * 16000)
        chunk_audio = audio_np[chunk_start_sample:chunk_end_sample].astype(np.float32)

        try:
            result = mlx_whisper.transcribe(
                chunk_audio,
                path_or_hf_repo=model_path,
                language=args.language,
                word_timestamps=(args.format == "json"),
                initial_prompt=args.initial_prompt if i == 0 else None,
                compression_ratio_threshold=2.4,
                logprob_threshold=-1.0,
                no_speech_threshold=0.6,
                condition_on_previous_text=False,  # BK-007: VAD 拆段后不需要跨段条件
            )
        except Exception as e:
            print(f"[transcribe] WARNING: segment {i+1}/{total} failed: {e}, skip", file=sys.stderr)
            continue

        last_language = result.get("language", "unknown")
        for j, seg in enumerate(result["segments"]):
            seg = dict(seg)  # 复制, 避免污染 mlx-whisper 内部缓存
            seg["start"] = seg.get("start", 0.0) + ts["start"]  # +VAD 偏移
            seg["end"] = seg.get("end", 0.0) + ts["start"]
            all_segments.append(seg)
            if args.verbose:
                lp = seg.get("avg_logprob", 0.0)
                if lp >= _QUALITY_GOOD_THRESHOLD:
                    label = "GOOD"
                elif lp >= _QUALITY_WARN_THRESHOLD:
                    label = "WARN"
                else:
                    label = "LOW"
                quality_counts[label] += 1
                quality_total += 1
                print(
                    f"[quality] vad {i+1}/{total} sub {j+1}: "
                    f"avg_logprob={lp:.2f} {label}",
                    file=sys.stderr,
                )

    # 5. 输出
    if args.language is None and last_language and last_language != "unknown":
        print(f"[检测到语言: {last_language}]")
    if args.verbose and quality_total > 0:
        g, w, l = quality_counts["GOOD"], quality_counts["WARN"], quality_counts["LOW"]
        print(
            f"[quality] summary: {g} GOOD, {w} WARN, {l} LOW out of {quality_total} segments",
            file=sys.stderr,
        )
    _write_output(args, all_segments, {"language": last_language, "language_probability": None})


if __name__ == "__main__":
    main()
