def _run_faster_whisper(args):
    """Sprint 19.2a 末态原 faster-whisper 路径, 完全不动, 仅外提为函数。"""
    if getattr(args, 'verbose', False):
        print("[transcribe] WARNING: --verbose not supported with faster-whisper backend", file=sys.stderr)
    from faster_whisper import WhisperModel

    print(f"[transcribe] backend=faster (fallback), model={args.model or 'large-v3'}")
    model = WhisperModel(args.model or "large-v3", device="cpu", compute_type="int8")
    segments, info = model.transcribe(
        args.audio_path,
        language=args.language,
        vad_filter=args.vad,
        word_timestamps=args.format == "json",
        initial_prompt=args.initial_prompt,
    )
    if args.language is None:
        print(f"[检测到语言: {info.language} ({info.language_probability:.1%})]")
