import argparse
import json
import os
import sys
from pathlib import Path


# ===== writer 函数 (L41-85 完整保留, 加 isinstance 兼容双端) =====

def format_timestamp(seconds: float) -> str:
    """SRT 格式: HH:MM:SS,mmm"""
    hours = int(seconds // 3600)
    minutes = int((seconds % 3600) // 60)
    secs = int(seconds % 60)
    millis = int((seconds % 1) * 1000)
    return f"{hours:02d}:{minutes:02d}:{secs:02d},{millis:03d}"


def _seg_text(seg):
    return seg["text"] if isinstance(seg, dict) else seg.text


def _seg_start(seg):
    return seg["start"] if isinstance(seg, dict) else seg.start


def _seg_end(seg):
    return seg["end"] if isinstance(seg, dict) else seg.end


def _seg_words(seg):
    words = seg.get("words") if isinstance(seg, dict) else seg.words
    return words or []


def _word_fields(w):
    if isinstance(w, dict):
        return w.get("start"), w.get("end"), w.get("word"), w.get("probability")
    return w.start, w.end, w.word, w.probability


def write_txt(segments, output_path: Path):
    with open(output_path, "w", encoding="utf-8") as f:
        for segment in segments:
            f.write(_seg_text(segment) + "\n")


def write_srt(segments, output_path: Path):
    with open(output_path, "w", encoding="utf-8") as f:
        for idx, segment in enumerate(segments, start=1):
            start = format_timestamp(_seg_start(segment))
            end = format_timestamp(_seg_end(segment))
            f.write(f"{idx}\n")
            f.write(f"{start} --> {end}\n")
            f.write(f"{_seg_text(segment)}\n\n")


def write_json(segments, info, output_path: Path):
    if isinstance(info, dict):
        language = info.get("language")
        language_probability = info.get("language_probability")
    else:
        language = info.language
        language_probability = getattr(info, "language_probability", None)
    data = {
        "language": language,
        "language_probability": language_probability,
        "segments": [
            {
                "id": i,
                "start": _seg_start(seg),
                "end": _seg_end(seg),
                "text": _seg_text(seg),
                "words": [
                    {
                        "start": ws,
                        "end": we,
                        "word": ww,
                        "probability": wp,
                    }
                    for w in _seg_words(seg)
                    for (ws, we, ww, wp) in [_word_fields(w)]
                ],
            }
            for i, seg in enumerate(segments)
        ],
    }
    with open(output_path, "w", encoding="utf-8") as f:
        json.dump(data, f, ensure_ascii=False, indent=2)


# ===== 辅助:统一 writer 入口 =====

def _write_output(args, segments, info):
    suffix = {"txt": ".txt", "srt": ".srt", "json": ".json"}[args.format]
    output_path = Path(args.audio_path).with_suffix(suffix)
    if args.format == "txt":
        write_txt(segments, output_path)
    elif args.format == "srt":
        write_srt(segments, output_path)
    elif args.format == "json":
        write_json(segments, info, output_path)
    print(f"[transcribe] saved {output_path}")


def _is_hf_repo_id(s: str) -> bool:
    """HF repo ID 形如 'mlx-community/whisper-large-v3-turbo-4bit' """
    return "/" in s and not s.startswith("~") and not s.startswith("/")


def _read_audio_ffmpeg(audio_path: str, target_sr: int = 16000) -> "np.ndarray":
    """用 ffmpeg 子进程读音频到 mono float32 numpy 数组。
    绕开 silero-vad 自带 read_audio (依赖 torchaudio + torchcodec, 装包太重)。
    """
    import subprocess
    import numpy as np
    cmd = [
        "ffmpeg", "-nostdin", "-loglevel", "error",
        "-i", audio_path,
        "-f", "s16le", "-acodec", "pcm_s16le",
        "-ac", "1", "-ar", str(target_sr),
        "-",  # stdout
    ]
    proc = subprocess.run(cmd, capture_output=True, check=True)
    raw = proc.stdout
    if not raw:
        raise RuntimeError(f"ffmpeg returned empty audio for: {audio_path}")
    # int16 → float32 (-1.0 ~ 1.0)
    audio = np.frombuffer(raw, dtype=np.int16).astype(np.float32) / 32768.0
    return audio


# ===== Silero v6 VAD Wrapper =====
# 手工实现 OnnxWrapper (参考 snakers4/silero-vad utils_vad.py L46-160)
# 绕开 silero-vad pip 自带 cache 下载, 模型走本地 ~/models/silero-v6/

class _VADWrapper:
    def __init__(self, onnx_path: str):
        import onnxruntime as ort
        import numpy as np
        opts = ort.SessionOptions()
        opts.inter_op_num_threads = 1
        opts.intra_op_num_threads = 1
        self.session = ort.InferenceSession(
            onnx_path, sess_options=opts, providers=["CPUExecutionProvider"]
        )
        self._state = np.zeros((2, 1, 128), dtype=np.float32)
        self._context = np.zeros(0, dtype=np.float32)
        self.sr = 0

    def reset_states(self) -> None:
        """每段/每文件开始时由 get_speech_timestamps 内部调用一次。"""
        import numpy as np
        self._state = np.zeros((2, 1, 128), dtype=np.float32)
        self._context = np.zeros(0, dtype=np.float32)
        self.sr = 0

    def __call__(self, x, sr: int):
        """x: torch.Tensor (1, num_samples) / sr: int → speech_prob: torch.Tensor (1, 1)
        chunk 长度约束: sr=16000 → 512 samples; sr=8000 → 256 samples.
        """
        import numpy as np
        import torch
        num_samples = 512 if sr == 16000 else 256
        context_size = 64 if sr == 16000 else 32

        x_np = x.squeeze(0).numpy() if hasattr(x, "numpy") else np.asarray(x)
        if x_np.shape[-1] < num_samples:
            x_np = np.pad(x_np, (0, num_samples - x_np.shape[-1]))
        elif x_np.shape[-1] > num_samples:
            x_np = x_np[:num_samples]

        if self._context.shape[0] == 0:
            self._context = np.zeros(context_size, dtype=np.float32)
        x_with_ctx = np.concatenate([self._context, x_np])

        out, state = self.session.run(
            None,
            {
                "input": x_with_ctx[None, :].astype(np.float32),
                "state": self._state,
                "sr": np.array(sr, dtype=np.int64),
            },
        )
        self._state = state
        self._context = x_with_ctx[-context_size:]
        self.sr = sr
        return torch.from_numpy(out)


# ===== backend 路由 =====

def main():
    parser = argparse.ArgumentParser(
        description="转录音频文件 (mlx-whisper + Silero v6 VAD; faster-whisper 保留为 fallback)",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("audio_path", help="音频文件路径")
    parser.add_argument(
        "--model",
        default=None,
        help="模型标识 (默认 ~/models/whisper-mlx 或 mlx-community/whisper-large-v3-turbo-4bit)",
    )
    parser.add_argument(
        "--language",
        default=None,
        help="语言代码, 不指定则模型自动检测",
    )
    parser.add_argument(
        "--format",
        choices=["txt", "srt", "json"],
        default="txt",
        help="输出格式 (默认 txt)",
    )
    parser.add_argument(
        "--vad",
        action="store_true",
        help="[no-op, 向后兼容] 新路径永远走 VAD",
    )
    parser.add_argument(
        "--initial-prompt",
        default=None,
        help="给模型的上下文提示 (仅第 1 段生效)",
    )
    parser.add_argument(
        "--verbose",
        action="store_true",
        help="输出每段转录质量 (avg_logprob) 到 stderr",
    )
    args = parser.parse_args()

    backend = os.getenv("WHISPER_BACKEND", "mlx").lower()
    if backend == "faster":
        _run_faster_whisper(args)
    else:
        _run_mlx_whisper_with_vad(args)


