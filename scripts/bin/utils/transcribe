#!/usr/bin/env python3
"""
transcribe — 用本地 faster-whisper 模型转录音频文件为纯文本

== 配置说明 ==

1. 安装依赖:
   pip install faster-whisper

2. 模型下载:
   本脚本使用 Systran/faster-whisper-large-v3（约 3GB）。
   国内用户首次运行前设置 HF 镜像源，模型会自动从镜像下载：
   export HF_ENDPOINT=https://hf-mirror.com
   可以写入 ~/.zshrc 长期生效。

3. 脚本安装:
   chmod +x 本文件
   mv 本文件 ~/bin/transcribe
   确认 ~/bin 在 PATH 中（echo $PATH）

4. device 用 mps（macOS Apple Silicon GPU 加速），
   遇到兼容问题回退到 device="cpu"。

5. compute_type 用 int8 加快推理速度，
   发现质量明显下降时改回 float16。

== 用法 ==
  transcribe meeting.mp3                    自动检测语言
  transcribe meeting.mp3 --language ja      指定日语
"""

import argparse
from pathlib import Path
from faster_whisper import WhisperModel


def main():
    parser = argparse.ArgumentParser(
        description="转录音频文件为纯文本",
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    parser.add_argument("audio_path", help="音频文件路径")
    parser.add_argument(
        "--model",
        default="large-v3",
        help="模型标识（默认 large-v3，Systran 版）",
    )
    parser.add_argument(
        "--language",
        default=None,
        help="语言代码，不指定则模型自动检测",
    )
    args = parser.parse_args()

    model = WhisperModel(args.model, device="cpu", compute_type="int8")
    segments, info = model.transcribe(args.audio_path, language=args.language)

    if args.language is None:
        print(f"[检测到语言: {info.language} ({info.language_probability:.1%})]")

    # 自动保存到同目录下，扩展名替换为 .txt
    output_path = Path(args.audio_path).with_suffix(".txt")
    with open(output_path, "w", encoding="utf-8") as f:
        for segment in segments:
            line = segment.text
            print(line)
            f.write(line + "\n")

    print(f"[已保存: {output_path}]")


if __name__ == "__main__":
    main()
